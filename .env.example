# Application
APP_NAME=AgentForge API
APP_ENV=development
APP_VERSION=0.1.0
API_PREFIX=
CORS_ORIGINS=http://localhost:5173

# Local ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Database
POSTGRES_DB=agentforge
POSTGRES_USER=agentforge
POSTGRES_PASSWORD=agentforge
DATABASE_URL=postgresql+psycopg://agentforge:agentforge@localhost:5432/agentforge

# RAG and AI
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
LLM_PROVIDER=fake
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RAG_TOP_K_DEFAULT=5
RAG_TOP_K_MAX=10
MAX_UPLOAD_SIZE_BYTES=10485760
SUPPORTED_CONTENT_TYPES=application/pdf,text/plain,text/markdown
