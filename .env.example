DATABASE_URL=postgresql+psycopg://agentforge:agentforge@localhost:5432/agentforge
POSTGRES_DB=agentforge
POSTGRES_USER=agentforge
POSTGRES_PASSWORD=agentforge
POSTGRES_PORT=5432
APP_ENV=development
APP_NAME=AgentForge API
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:5173
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
LLM_PROVIDER=fake
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
OPENAI_API_KEY=
RATE_LIMIT_BACKEND=memory
REDIS_URL=
REDIS_SSL_CA_CERT=
FORWARDED_ALLOW_IPS=127.0.0.1
SESSION_TTL_SECONDS=3600
AUTH_ATTEMPTS_PER_MINUTE=10
AI_REQUESTS_PER_MINUTE=20
MAX_PROMPT_CHARS=5000
MAX_REQUEST_BODY_BYTES=65536
MAX_STREAM_DURATION_SECONDS=60
MAX_STREAM_OUTPUT_CHARS=12000
MAX_EXTRACTED_CHARS=2000000
MAX_PDF_PAGES=200
MAX_DOCUMENT_CHUNKS=2500
EMBEDDING_BATCH_SIZE=32
MAX_AGENT_STEPS=5
MAX_TOOL_CALLS=4
MAX_CONVERSATION_MESSAGES=20
MAX_CONVERSATION_CONTEXT_CHARS=8000
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RAG_TOP_K_DEFAULT=5
RAG_TOP_K_MAX=10
RAG_CANDIDATE_MAX=30
RAG_MIN_SIMILARITY=-1.0
RAG_MAX_CONTEXT_CHARS=6000
MAX_UPLOAD_SIZE_BYTES=10485760
SUPPORTED_CONTENT_TYPES=application/pdf,text/plain,text/markdown

# Managed PostgreSQL note:
# Hosted providers commonly supply postgres:// or postgresql:// URLs.
# AgentForge normalizes those to postgresql+psycopg automatically.
# For Supabase production, use the Session Pooler connection string and keep SSL enabled.
# Example shape: postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require

# Frontend build-time configuration:
# VITE_API_BASE_URL= omit for same-origin production, or pass an HTTPS API URL during the frontend build.
